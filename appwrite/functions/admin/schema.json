  "premium_plans": {
    "label": "Premium plans",
    "kind": "plan",
    "fields": [
      {
        "key": "name",
        "type": "string",
        "size": 128,
        "required": true
      },
      {
        "key": "description",
        "type": "string",
        "size": 2000,
        "required": false
      },
      {
        "key": "price",
        "type": "double",
        "min": 0,
        "max": 100000,
        "required": true
      },
      {
        "key": "currency",
        "type": "string",
        "size": 3,
        "required": true
      },
      {
        "key": "billingInterval",
        "type": "enum",
        "elements": [
          "monthly",
          "yearly",
          "one-time"
        ],
        "required": true
      },
      {
        "key": "features",
        "type": "string",
        "size": 500,
        "required": false,
        "array": true
      },
      {
        "key": "status",
        "type": "enum",
        "elements": [
          "draft",
          "ready",
          "archived"
        ],
        "required": true
      }
    ],
    "note": "Prepare prices and benefits for a future launch. Checkout and automatic billing are disabled."
  },
  "site_content": {
    "label": "Website content",
    "kind": "section",
    "fields": [
      {
        "key": "name",
        "type": "string",
        "size": 128,
        "required": true
      },
      {
        "key": "placement",
        "type": "enum",
        "elements": [
          "hero",
          "section",
          "footer"
        ],
        "required": true
      },
      {
        "key": "title",
        "type": "string",
        "size": 256,
        "required": true
      },
      {
        "key": "body",
        "type": "string",
        "size": 6000,
        "required": false
      },
      {
        "key": "buttonLabel",
        "type": "string",
        "size": 128,
        "required": false
      },
      {
        "key": "buttonUrl",
        "type": "string",
        "size": 512,
        "required": false,
        "format": "url"
      },
      {
        "key": "sortOrder",
        "type": "integer",
        "min": 0,
        "max": 10000
      },
      {
        "key": "isPublished",
        "type": "boolean",
        "required": true
      }
    ],
    "published": true,
    "note": "The main-hero record controls the existing website heading and introduction. Published sections and footer content appear below it. Keep future sections as drafts."
  },
  "announcements": {
    "label": "Announcements",
    "kind": "announcement",
    "fields": [
      {
        "key": "name",
        "type": "string",
        "size": 128,
        "required": true
      },
      {
        "key": "title",
        "type": "string",
        "size": 256,
        "required": true
      },
      {
        "key": "body",
        "type": "string",
        "size": 2000,
        "required": true
      },
      {
        "key": "buttonLabel",
        "type": "string",
        "size": 128,
        "required": false
      },
      {
        "key": "buttonUrl",
        "type": "string",
        "size": 512,
        "required": false,
        "format": "url"
      },
      {
        "key": "isPublished",
        "type": "boolean",
        "required": true
      }
    ],
    "published": true,
    "note": "Publish notices in the website sidebar. Drafts stay private."
  },
  "admin_subscriptions": {
    "label": "Premium access",
    "kind": "access record",
    "fields": [
      {
        "key": "userId",
        "type": "string",
        "size": 36,
        "required": true
      },
      {
        "key": "planId",
        "type": "string",
        "size": 36,
        "required": true
      },
      {
        "key": "status",
        "type": "enum",
        "elements": [
          "active",
          "revoked"
        ],
        "required": true
      },
      {
        "key": "expiresAt",
        "type": "datetime",
        "required": true
      },
      {
        "key": "note",
        "type": "string",
        "size": 1000,
        "required": false
      }
    ],
    "private": true
  },
  "admin_activity": {
    "label": "Activity log",
    "kind": "event",
    "fields": [
      {
        "key": "actorId",
        "type": "string",
        "size": 36,
        "required": true
      },
      {
        "key": "action",
        "type": "string",
        "size": 128,
        "required": true
      },
      {
        "key": "target",
        "type": "string",
        "size": 256,
        "required": true
      },
      {
        "key": "result",
        "type": "enum",
        "elements": [
          "pending",
          "completed",
          "failed"
        ],
        "required": true
      },
      {
        "key": "detail",
        "type": "string",
        "size": 1000,
        "required": false
      }
    ],
    "private": true
  }
}
